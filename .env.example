# Ableo Environment Configuration

# Gemini API key from Google AI Studio
# If set, Gemini 2.5 Flash will be used for:
# - Resume to Profile Parsing
# - Match Explanations ("Ask AI Why")
# - Interview Coaching and Mock Answers
# - Skill Gap Analysis
#
# If NOT set, Ableo runs 100% locally with built-in heuristic algorithms!
GEMINI_API_KEY=

# Optional: Port configuration (defaults to 3000 / Vite auto-assign)
# PORT=3000
