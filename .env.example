# Ableo Environment Configuration

# ==============================================================================
# Database Configuration (MongoDB Atlas)
# ==============================================================================
# MONGODB_URI: Full connection string to your MongoDB Atlas cluster.
# Format: mongodb+srv://<username>:<password>@<cluster-subdomain>.mongodb.net/<database_name>?retryWrites=true&w=majority
#
# Notes:
#  - Replace <username> and <password> with your MongoDB database user credentials.
#  - The default database name is "ableo". If omitted, Ableo automatically uses "ableo".
#  - If MONGODB_URI is left empty or not provided, Ableo automatically falls back
#    to local SQLite storage (stored at data/ableo.db) so you can run offline.
#
# Example:
# MONGODB_URI=mongodb+srv://db_user:my_secret_password@cluster0.abcde.mongodb.net/ableo?retryWrites=true&w=majority
MONGODB_URI=

# TinyFish API Key for Web Automations
# Used to search live web job boards for inclusive & accessible job listings.
TINYFISH_API_KEY=

# Gemini API key from Google AI Studio (https://aistudio.google.com/)
# If set, Gemini 2.5 Flash will be used for:
# - Resume to Profile Parsing
# - Match Explanations ("Ask AI Why")
# - Interview Coaching and Mock Answers
# - Skill Gap Analysis
#
# If NOT set, Ableo runs 100% locally with built-in heuristic algorithms!
GEMINI_API_KEY=

# Local Ollama model used by Jarvis project questions.
# Start Ollama with: ollama serve
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
LOVABLE_API_KEY=

# Optional: Google Maps Platform API Key
# For Google Maps JavaScript API with @vis.gl/react-google-maps
# If not provided, Ableo uses an interactive built-in hub map schematic
VITE_GOOGLE_MAPS_API_KEY=

# Administrator Emails (comma-separated, enables multi-portal access for both Candidate and Employer)
# Must be set explicitly to grant admin access; there is NO hardcoded default admin in the codebase.
# Example: ADMIN_EMAILS=admin@yourdomain.com,security@yourdomain.com
ADMIN_EMAILS=

# Email Delivery (Resend API)
# If provided, password reset and verification emails will be sent via Resend.
# If omitted, emails are securely logged to the server console during development.
RESEND_API_KEY=
EMAIL_FROM=Ableo <support@ableo.app>
APP_URL=http://localhost:8080
REQUIRE_EMAIL_VERIFICATION=false

# Optional: Port configuration (defaults to 3000 / Vite auto-assign)
# PORT=3000

# Optional: WebAuthn / Biometrics (defaults to localhost:3000, localhost:5173, localhost:8080)
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:8080
