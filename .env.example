# Ableo Environment Configuration

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/ableo?retryWrites=true&w=majority
MONGODB_URI=

# TinyFish API Key for Web Automations
TINYFISH_API_KEY=

# Gemini API key from Google AI Studio
# If set, Gemini 2.5 Flash will be used for:
# - Resume to Profile Parsing
# - Match Explanations ("Ask AI Why")
# - Interview Coaching and Mock Answers
# - Skill Gap Analysis
#
# If NOT set, Ableo runs 100% locally with built-in heuristic algorithms!
GEMINI_API_KEY=
LOVABLE_API_KEY=

# Optional: Google Maps Platform API Key
# For Google Maps JavaScript API with @vis.gl/react-google-maps
# If not provided, Ableo uses an interactive built-in hub map schematic
VITE_GOOGLE_MAPS_API_KEY=

# Optional: Administrator Emails (comma-separated, enables multi-portal access)
ADMIN_EMAILS=fernandesallan745@gmail.com

# Email Delivery (Resend API)
# If provided, password reset and verification emails will be sent via Resend.
# If omitted, emails are securely logged to the server console during development.
RESEND_API_KEY=
EMAIL_FROM=Ableo <support@ableo.app>
APP_URL=http://localhost:8080
REQUIRE_EMAIL_VERIFICATION=false

# Optional: Port configuration (defaults to 3000 / Vite auto-assign)
# PORT=3000


